# Copy this file to android/key.properties and fill in your private values.
# NEVER commit android/key.properties or your .jks/.keystore file.
# storeFile may be an absolute path or a path resolvable from the android project.
storePassword=YOUR_PRIVATE_STORE_PASSWORD
keyPassword=YOUR_PRIVATE_KEY_PASSWORD
keyAlias=speed_math_release
storeFile=/absolute/path/to/speed-math-release.jks
