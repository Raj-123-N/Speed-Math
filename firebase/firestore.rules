rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public app content: read-only, single published document.
    match /publishedContent/current {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Draft curriculum is private to authenticated administrators.
    match /draftTopics/{topicId} {
      allow read, write: if isAdmin();
    }

    // Admin allow-list is intentionally not writable from the client.
    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
