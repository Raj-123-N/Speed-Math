rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public app content: read-only, single published document.
    match /publishedContent/current {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Draft curriculum is private to authenticated administrators.
    match /draftTopics/{topicId} {
      allow read, write: if isAdmin();
    }

    // Admin allow-list is intentionally not writable from the client.
    match /admins/{uid} {
      allow read: if isAdmin() && request.auth.uid == uid;
      allow write: if false;
    }

    // User Feedback and Issue Reports:
    // Anyone can create a report with valid type and non-empty description.
    // Only authenticated admins can read, update (resolve), or delete reports.
    match /reports/{reportId} {
      allow create: if request.resource.data.type in ['wrong_question', 'wrong_learn', 'issue', 'feedback']
                    && request.resource.data.description is string
                    && request.resource.data.description.size() > 0;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
